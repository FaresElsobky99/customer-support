# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required (backend raises at import if these are missing) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# --- Product agent / chatbot ---
# Which LLM backend the agent uses: "gemini" or "openrouter".
LLM_PROVIDER=gemini

# Max tool-call iterations before the agent gives up on a single turn.
AGENT_MAX_STEPS=6

# -- gemini --
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# -- openrouter (free models available; you need your OWN key, not a shared one) --
# 1. Sign up free at https://openrouter.ai  2. Keys -> Create API Key  3. paste below.
OPENROUTER_API_KEY=sk-or-v1-...
# "openrouter/free" auto-routes to an available free tool-capable model. Pin a specific
# one via https://openrouter.ai/models?max_price=0 (must support "Tools").
OPENROUTER_MODEL=openrouter/free
